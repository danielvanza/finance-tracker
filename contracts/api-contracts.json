{
  "$comment": "Backend->frontend API contract for the finance-tracker re-platform. Extracted from backend/routers/* (routes) + frontend/src/api.ts (call sites) at commit 18c3530, extended with the v2 money-wire decision (amounts as integer cents). The merge gate's contract-seam stage verifies both sides against this file. All amounts in responses/requests are integer cents unless marked '_legacy_float'.",
  "version": "2.0.0",
  "base_url_dev": "/api (Vite proxy -> http://localhost:8000, rewrite strips /api)",
  "conventions": {
    "auth": "none",
    "errors": "FastAPI {detail: string} with 404/422 status; 422 detail is a human-readable validation message",
    "dates": "YYYY-MM-DD strings; months are YYYY-MM label months resolved via financial_month_start_day setting (default 24)",
    "money_wire_format_v2": {
      "rule": "Every monetary value crosses the wire as integer cents. Field names keep their current names (amount, planned_amount, ...) — the UNIT changes, not the name. Frontend converts only at render/input boundaries via src/money.ts.",
      "migration_note": "B1 ships serializers; F1 flips frontend consumption atomically. Between B1 merge and F1 merge the frontend shows cents-scaled values — sequenced same-night per TASK-DAG.md to avoid shipping that state."
    }
  },
  "endpoints": [
    {
      "id": "health",
      "method": "GET",
      "path": "/health",
      "request": null,
      "response": {
        "status": "\"ok\" (literal)"
      },
      "frontend_caller": null
    },
    {
      "id": "import-preview",
      "method": "POST",
      "path": "/import/preview",
      "request": "multipart/form-data: file (an ING export, English or Dutch column names)",
      "response": {
        "rows": [
          {
            "date": "date",
            "amount_cents": "int",
            "description": "string",
            "source": "string",
            "import_hash": "string",
            "duplicate": "bool"
          }
        ],
        "total": "int",
        "duplicates": "int"
      },
      "frontend_caller": "api.previewImport"
    },
    {
      "id": "import-confirm",
      "method": "POST",
      "path": "/import/confirm",
      "request": "multipart/form-data: file (an ING export, English or Dutch column names)",
      "response": {
        "imported": "int",
        "skipped_duplicates": "int",
        "categorised_by_rule": "int",
        "categorised_by_ai": "int (Claude was sure; counted)",
        "doubtful": "int (waiting for an answer)",
        "uncategorised": "int"
      },
      "frontend_caller": "api.confirmImport"
    },
    {
      "id": "transactions-list",
      "method": "GET",
      "path": "/transactions",
      "query": {
        "month": "YYYY-MM (optional)",
        "category_id": "int (optional)",
        "source": "ing|manual (optional)",
        "confirmed": "bool (optional)"
      },
      "response": {
        "type": "TransactionOut[]",
        "ordering": "unconfirmed first, then date desc"
      },
      "frontend_caller": "api.getTransactions"
    },
    {
      "id": "transactions-next-review",
      "method": "GET",
      "path": "/transactions/review",
      "query": {
        "skip_ids": "repeated int query params (optional)"
      },
      "response": "TransactionOut | null (null = review queue empty)",
      "frontend_caller": "api.getNextReview"
    },
    {
      "id": "transaction-create",
      "method": "POST",
      "path": "/transactions",
      "request": {
        "date": "date",
        "amount_cents": "int non-zero",
        "description": "string",
        "category_id": "int existing",
        "is_refund": "bool=false (must be expense category if true, amount must be positive)"
      },
      "response": "TransactionOut (201); always source=manual, confirmed=true, categorised_by=manual",
      "frontend_caller": "api.createTransaction"
    },
    {
      "id": "transaction-patch",
      "method": "PATCH",
      "path": "/transactions/{tx_id}",
      "request": {
        "category_id": "int|null (optional)",
        "confirmed": "bool (optional)",
        "is_refund": "bool (optional; validated against category types)",
        "splits": "[{category_id:int, amount_cents:int}] | [] to unsplit | absent to leave untouched (optional; 2+ parts, sum must equal amount_cents, parts share parent's sign)",
        "remember": "bool (optional; also make this payment's category the rule for its shop)"
      },
      "response": "TransactionOut",
      "frontend_caller": "api.patchTransaction"
    },
    {
      "id": "transaction-delete",
      "method": "DELETE",
      "path": "/transactions/{tx_id}",
      "request": null,
      "response": {
        "deleted": "int"
      },
      "error_contract": "422 if source != manual (imported rows immutable)",
      "frontend_caller": "api.deleteTransaction"
    },
    {
      "id": "categories-list",
      "method": "GET",
      "path": "/categories",
      "response": "CategoryOut[] ordered by sort_order",
      "frontend_caller": "api.getCategories"
    },
    {
      "id": "category-create",
      "method": "POST",
      "path": "/categories",
      "request": {
        "name": "string unique non-blank",
        "type": "needs|wants|savings|income|exclude",
        "sort_order": "int optional (default max+1)"
      },
      "response": "CategoryOut (201); budgeted types also get a zero-amount default Budget row",
      "frontend_caller": "api.createCategory"
    },
    {
      "id": "category-patch",
      "method": "PATCH",
      "path": "/categories/{category_id}",
      "request": {
        "name": "string optional",
        "type": "string optional"
      },
      "response": "CategoryOut",
      "v2_change_category_type_guard": {
        "behaviour": "Changing type is REJECTED with 422 when dependents exist: transactions/splits referencing it whose sign no longer fits, or rules on it — unless request includes force:true",
        "force_field": "force: bool = false added to request body",
        "response_on_block": "422 {detail} listing dependent counts (same census shape delete uses)"
      },
      "frontend_caller": "api.patchCategory"
    },
    {
      "id": "category-reorder",
      "method": "PATCH",
      "path": "/categories/reorder",
      "request": {
        "category_ids": "int[] len>=2, complete permutation subset"
      },
      "response": "[{id, sort_order}] in request order",
      "frontend_caller": "api.reorderCategories"
    },
    {
      "id": "category-delete",
      "method": "DELETE",
      "path": "/categories/{category_id}",
      "response": {
        "deleted": "int"
      },
      "error_contract": "422 with per-kind usage counts when in use by transaction/split/rule",
      "frontend_caller": "api.deleteCategory"
    },
    {
      "id": "budget-get",
      "method": "GET",
      "path": "/budget",
      "query": {
        "month": "YYYY-MM required"
      },
      "response": "BudgetRow[]: { id, category_id, category_name, category_type, month, planned_amount_cents, actual_amount_cents } — actual nets refunds and reads split parts; auto-populates from defaults; may be negative",
      "frontend_caller": "api.getBudget"
    },
    {
      "id": "budget-patch-month",
      "method": "PATCH",
      "path": "/budget/{budget_id}",
      "request": {
        "planned_amount_cents": "int"
      },
      "response": "{id, planned_amount_cents, category_name, month, months_changed}; the amount applies from this row's month on, through the later months that still held the old amount",
      "frontend_caller": "api.patchBudget"
    },
    {
      "id": "rules-list",
      "method": "GET",
      "path": "/rules",
      "response": "RuleOut[] oldest first",
      "frontend_caller": "api.getRules"
    },
    {
      "id": "rule-create",
      "method": "POST",
      "path": "/rules",
      "request": {
        "pattern": "string (2+ characters)",
        "category_id": "int existing"
      },
      "response": "RuleOut",
      "frontend_caller": "api.createRule"
    },
    {
      "id": "rule-update",
      "method": "PATCH",
      "path": "/rules/{rule_id}",
      "request": "subset of {pattern, category_id}",
      "response": "RuleOut",
      "frontend_caller": null
    },
    {
      "id": "rule-delete",
      "method": "DELETE",
      "path": "/rules/{rule_id}",
      "response": {
        "deleted": "int"
      },
      "frontend_caller": "api.deleteRule"
    },
    {
      "id": "ask-shops-list",
      "method": "GET",
      "path": "/rules/ask-shops",
      "response": "[{pattern}]: shops whose payments are always asked about, never sorted by themselves",
      "frontend_caller": "api.getAskShops"
    },
    {
      "id": "ask-shop-create",
      "method": "POST",
      "path": "/rules/ask-shops",
      "request": {
        "transaction_id": "int: a payment at the shop"
      },
      "response": "{pattern, removed_rules: [string]}; rules that sorted the shop are removed",
      "frontend_caller": "api.alwaysAsk"
    },
    {
      "id": "ask-shop-delete",
      "method": "DELETE",
      "path": "/rules/ask-shops",
      "query": {
        "pattern": "string"
      },
      "response": {
        "deleted": "string"
      },
      "frontend_caller": "api.deleteAskShop"
    },
    {
      "id": "dashboard-summary",
      "method": "GET",
      "path": "/dashboard/summary",
      "query": {
        "month": "YYYY-MM required"
      },
      "response": {
        "month": "string",
        "total_income_cents": "int",
        "total_expenses_cents": "int",
        "total_savings_cents": "int",
        "left_over_cents": "int (= income - expenses)",
        "category_breakdown": "[{category_id, category_name, actual_cents, planned_cents, type}] needs/wants/savings only, refunds netted",
        "income_breakdown": "[{category_id, category_name, amount_cents}] income-type categories, refunds excluded",
        "needs_wants_savings": "{ needs_cents, wants_cents, savings_cents }",
        "monthly_trend": "[{month, total_cents}] last 6 financial months incl. requested"
      },
      "frontend_caller": "api.getDashboard"
    },
    {
      "id": "dashboard-trends",
      "method": "GET",
      "path": "/dashboard/trends",
      "query": {
        "months": "int 1-24 optional (default 12)",
        "end_month": "YYYY-MM optional; default = label month containing today via financial_month_start_day"
      },
      "response": {
        "months_requested": "int (echoed months)",
        "start_month": "YYYY-MM (label of series[0])",
        "end_month": "YYYY-MM (label of last series entry)",
        "series": "[{month, total_expenses_cents, needs_cents, wants_cents, savings_cents, total_income_cents, net_cents, savings_rate_bps, top_categories, mom_deltas}] oldest→newest; savings_rate_bps int|null (null when income <= 0); top_categories [{category_id, category_name, type, actual_cents}] top 5 expense-type; mom_deltas null on series[0] else {total_expenses_cents, needs_cents, wants_cents, savings_cents, total_income_cents, net_cents, savings_rate_bps} signed vs previous entry"
      },
      "error_contract": "422 months outside 1-24 (FastAPI ge/le), 422 malformed end_month ({detail: string})",
      "frontend_caller": "api.getTrends"
    },
    {
      "id": "dashboard-pace",
      "method": "GET",
      "path": "/dashboard/pace",
      "query": {
        "month": "YYYY-MM optional; default = label month containing today via financial_month_start_day; triggers budget auto-population"
      },
      "response": {
        "status": "ok | gap (bank files exist, none reach this month) | empty (no bank file ever)",
        "month, current_month": "YYYY-MM",
        "start_date, end_date, today, data_through": "ISO date; data_through null unless status ok",
        "days_total": "int",
        "day_number, days_left": "int, null unless month is current",
        "plan_cents, actual_cents": "{needs, wants, savings} integer cents",
        "spendable_plan_cents, spendable_actual_cents": "needs + wants, integer cents",
        "pace_delta_cents": "int|null; spent minus plan-by-now through data_through, positive = over",
        "daily": "[{date, cumulative_cents}] needs + wants, each day from start_date through data_through",
        "last_import_by_bank": "[{source, last_date|null}] for ing",
        "behind_months": "[YYYY-MM] from the last bank file's month through current_month",
        "to_review": "int unconfirmed transactions, all months"
      },
      "error_contract": "422 malformed month ({detail: string})",
      "frontend_caller": "api.getPace"
    },
    {
      "id": "settings-get",
      "method": "GET",
      "path": "/settings",
      "response": "map<string,string> e.g. { financial_month_start_day: \"24\" }",
      "frontend_caller": "api.getSettings"
    },
    {
      "id": "setting-patch",
      "method": "PATCH",
      "path": "/settings/{key}",
      "request": {
        "value": "string (validated per key; financial_month_start_day must be 1-28 digits)"
      },
      "response": "{ key, value }",
      "error_contract": "404 unknown key, 422 invalid value",
      "frontend_caller": "api.patchSetting"
    },
    {
      "id": "chat-messages-get",
      "method": "GET",
      "path": "/chat/messages",
      "response": "{ messages, guesses_waiting, claude_busy }",
      "error_contract": "422 unknown channel",
      "frontend_caller": "api.getChat"
    },
    {
      "id": "chat-message-post",
      "method": "POST",
      "path": "/chat/messages",
      "request": {
        "channel": "bubble|telegram",
        "text": "string",
        "choose_transaction_id": "int|null",
        "seen_message_id": "int|null"
      },
      "response": "ChatMessage, plus a settled card when the text was a yes or no",
      "error_contract": "404 unknown transaction, 422 empty",
      "frontend_caller": "api.sendChatMessage"
    },
    {
      "id": "chat-new",
      "method": "POST",
      "path": "/chat/new",
      "request": {
        "channel": "bubble|telegram"
      },
      "response": "{ new_chat }: later messages start a fresh conversation; what came before is kept but not shown or remembered",
      "error_contract": "422 unknown channel",
      "frontend_caller": "api.newChat"
    },
    {
      "id": "chat-stop",
      "method": "POST",
      "path": "/chat/stop",
      "request": {
        "channel": "bubble|telegram"
      },
      "response": "{ stopped }: how many messages in that chat were being worked on or waiting",
      "error_contract": "422 unknown channel",
      "frontend_caller": "api.stopChat"
    },
    {
      "id": "chat-outbox-get",
      "method": "GET",
      "path": "/chat/outbox",
      "response": "{ replies, in_flight }: replies a pushing chat has not shown yet, and each in-flight message with its live steps",
      "error_contract": "422 unknown channel",
      "frontend_caller": null
    },
    {
      "id": "chat-message-delivered",
      "method": "POST",
      "path": "/chat/messages/{message_id}/delivered",
      "request": {
        "message_ids": "[int] Telegram messages showing this reply"
      },
      "response": "{ delivered }",
      "error_contract": "404",
      "frontend_caller": null
    },
    {
      "id": "chat-chart-get",
      "method": "GET",
      "path": "/chat/messages/{message_id}/chart",
      "request": {
        "theme": "day|night (query, default day)",
        "v": "the message's created_at (query, ignored): keeps a browser from reusing the picture of a cleared chat"
      },
      "response": "image/png: the chart drawn from the numbers saved with that reply",
      "error_contract": "404 no such message or no chart, 422 unknown theme",
      "frontend_caller": "api.chatChartUrl"
    },
    {
      "id": "chat-file-post",
      "method": "POST",
      "path": "/chat/files",
      "request": {
        "channel": "bubble|telegram",
        "file": "multipart"
      },
      "response": "ChatMessage (handled in the background)",
      "error_contract": "422 unknown channel",
      "frontend_caller": "api.sendChatFile"
    },
    {
      "id": "chat-proposal-apply",
      "method": "POST",
      "path": "/chat/proposals/{proposal_id}/apply",
      "request": {
        "version": "string (the card's version when tapped)"
      },
      "response": "Card; idempotent; unchanged if the version was replaced",
      "error_contract": "404, 422",
      "frontend_caller": "api.applyChatProposal"
    },
    {
      "id": "chat-proposal-reject",
      "method": "POST",
      "path": "/chat/proposals/{proposal_id}/reject",
      "response": "Card",
      "error_contract": "404",
      "frontend_caller": "api.rejectChatProposal"
    },
    {
      "id": "chat-proposal-remember",
      "method": "POST",
      "path": "/chat/proposals/{proposal_id}/remember",
      "response": "Card; makes a rule for each shop the applied card sorted; idempotent",
      "error_contract": "404",
      "frontend_caller": "api.rememberChatShops"
    },
    {
      "id": "set-asides-list",
      "method": "GET",
      "path": "/set-asides",
      "request": {
        "month": "YYYY-MM optional"
      },
      "response": "{month, items: [SetAside], set_aside_cents}",
      "frontend_caller": "api.getSetAsides"
    },
    {
      "id": "set-aside-create",
      "method": "POST",
      "path": "/set-asides",
      "request": {
        "name": "string",
        "amount_cents": "int > 0",
        "due_month": "YYYY-MM",
        "every_months": "int 2-60 or null=12"
      },
      "response": "{month, items: [SetAside], set_aside_cents} (201)",
      "frontend_caller": "api.createSetAside"
    },
    {
      "id": "set-aside-patch",
      "method": "PATCH",
      "path": "/set-asides/{bill_id}",
      "request": "any of name, amount_cents, due_month, every_months",
      "response": "{month, items: [SetAside], set_aside_cents}",
      "frontend_caller": null
    },
    {
      "id": "set-aside-delete",
      "method": "DELETE",
      "path": "/set-asides/{bill_id}",
      "request": null,
      "response": "{month, items: [SetAside], set_aside_cents}",
      "frontend_caller": "api.deleteSetAside"
    },
    {
      "id": "set-aside-pay",
      "method": "POST",
      "path": "/set-asides/{bill_id}/payments",
      "request": {
        "transaction_id": "int, an outgoing payment"
      },
      "response": "{month, items: [SetAside], set_aside_cents}",
      "frontend_caller": "api.paySetAside"
    },
    {
      "id": "set-aside-unpay",
      "method": "DELETE",
      "path": "/set-asides/{bill_id}/payments/{transaction_id}",
      "request": null,
      "response": "{month, items: [SetAside], set_aside_cents}",
      "frontend_caller": "api.unpaySetAside"
    },
    {
      "id": "recurring-ignore",
      "method": "POST",
      "path": "/recurring/ignored",
      "request": {
        "key": "string"
      },
      "response": {
        "ignored": "string"
      },
      "frontend_caller": "api.ignoreBill"
    },
    {
      "id": "recurring-count-again",
      "method": "DELETE",
      "path": "/recurring/ignored/{key}",
      "request": null,
      "response": {
        "counted": "string"
      },
      "frontend_caller": "api.countBillAgain"
    },
    {
      "id": "chat-proposal-show-all",
      "method": "POST",
      "path": "/chat/proposals/{proposal_id}/show-all",
      "request": null,
      "response": {
        "shown": "int"
      },
      "frontend_caller": null
    },
    {
      "id": "chat-voice-post",
      "method": "POST",
      "path": "/chat/voice",
      "request": "multipart/form-data: channel, file",
      "response": "ChatMessage with heard, or {heard: null}",
      "frontend_caller": null
    },
    {
      "id": "chat-photo-post",
      "method": "POST",
      "path": "/chat/photos",
      "request": "multipart/form-data: channel, caption, file",
      "response": "ChatMessage",
      "frontend_caller": null
    },
    {
      "id": "chat-question-answer",
      "method": "POST",
      "path": "/chat/questions/{message_id}/answer",
      "request": {
        "option": "int"
      },
      "response": "ChatMessage",
      "frontend_caller": null
    },
    {
      "id": "chat-question-something-else",
      "method": "POST",
      "path": "/chat/questions/{message_id}/something-else",
      "request": null,
      "response": "ChatMessage (the question); the app's request to say what it is follows in the outbox",
      "frontend_caller": null
    }
  ],
  "shared_envelope_shapes": {
    "TransactionOut": {
      "id": "int",
      "date": "YYYY-MM-DD",
      "amount_cents": "int (negative = expense, positive = income or refund)",
      "description": "string",
      "source": "ing|manual",
      "category_id": "int|null (null when split)",
      "category_name": "string|null",
      "confirmed": "bool",
      "categorised_by": "rule|ai|manual|null",
      "ai_confidence": "float|null",
      "is_refund": "bool",
      "splits": "[{id, category_id, category_name, amount_cents, is_refund(bool, v2)}] empty when unsplit"
    },
    "CategoryOut": {
      "id": "int",
      "name": "string",
      "type": "needs|wants|savings|income|exclude",
      "sort_order": "int"
    },
    "RuleOut": {
      "id": "int",
      "pattern": "string",
      "category_id": "int",
      "category_name": "string"
    }
  }
}
