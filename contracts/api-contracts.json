{
  "$comment": "Backend->frontend API contract for the finance-tracker re-platform. Extracted from backend/routers/* (routes) + frontend/src/api.ts (call sites) at commit 18c3530, extended with the v2 money-wire decision (amounts as integer cents). The merge gate's contract-seam stage verifies both sides against this file. All amounts in responses/requests are integer cents unless marked '_legacy_float'.",
  "version": "2.0.0",
  "base_url_dev": "/api (Vite proxy -> http://localhost:8000, rewrite strips /api)",
  "conventions": {
    "auth": "none",
    "errors": "FastAPI {detail: string} with 404/422 status; 422 detail is a human-readable validation message",
    "dates": "YYYY-MM-DD strings; months are YYYY-MM label months resolved via financial_month_start_day setting (default 24)",
    "money_wire_format_v2": {
      "rule": "Every monetary value crosses the wire as integer cents. Field names keep their current names (amount, planned_amount, ...) — the UNIT changes, not the name. Frontend converts only at render/input boundaries via src/money.ts.",
      "migration_note": "B1 ships serializers; F1 flips frontend consumption atomically. Between B1 merge and F1 merge the frontend shows cents-scaled values — sequenced same-night per TASK-DAG.md to avoid shipping that state."
    }
  },
  "endpoints": [
    {
      "id": "health",
      "method": "GET", "path": "/health",
      "request": null,
      "response": { "status": "\"ok\" (literal)" },
      "frontend_caller": null
    },
    {
      "id": "import-preview",
      "method": "POST", "path": "/import/preview",
      "request": { "content_type": "multipart/form-data", "fields": { "source": "ing|revolut|degiro", "file": "CSV file" } },
      "response": { "rows": [{ "date": "date", "amount_cents": "int", "description": "string", "source": "string", "import_hash": "string", "duplicate": "bool" }], "total": "int", "duplicates": "int" },
      "frontend_caller": "api.previewImport"
    },
    {
      "id": "import-confirm",
      "method": "POST", "path": "/import/confirm",
      "request": { "content_type": "multipart/form-data", "fields": { "source": "ing|revolut|degiro", "file": "CSV file" } },
      "response": { "imported": "int", "skipped_duplicates": "int", "categorised_by_rule": "int", "categorised_by_ai": "int", "uncategorised": "int" },
      "frontend_caller": "api.confirmImport"
    },
    {
      "id": "transactions-list",
      "method": "GET", "path": "/transactions",
      "query": { "month": "YYYY-MM (optional; triggers standing-adjustment materialisation)", "category_id": "int (optional)", "source": "ing|revolut|degiro|manual (optional)", "confirmed": "bool (optional)" },
      "response": { "type": "TransactionOut[]", "ordering": "unconfirmed first, then date desc" },
      "frontend_caller": "api.getTransactions"
    },
    {
      "id": "transactions-next-review",
      "method": "GET", "path": "/transactions/review",
      "query": { "skip_ids": "repeated int query params (optional)" },
      "response": "TransactionOut | null (null = review queue empty)",
      "frontend_caller": "api.getNextReview"
    },
    {
      "id": "transaction-create",
      "method": "POST", "path": "/transactions",
      "request": { "date": "date", "amount_cents": "int non-zero", "description": "string", "category_id": "int existing", "is_refund": "bool=false (must be expense category if true, amount must be positive)" },
      "response": "TransactionOut (201); always source=manual, confirmed=true, categorised_by=manual",
      "frontend_caller": "api.createTransaction"
    },
    {
      "id": "transaction-adjustment-pair",
      "method": "POST", "path": "/transactions/adjustment-pair",
      "request": { "date": "date", "description": "string", "legs": [{ "amount_cents": "int non-zero", "category_id": "int", "description": "string|null" }] },
      "response": "TransactionOut[] length 2 (201); legs must net to exactly zero",
      "frontend_caller": "api.createAdjustmentPair"
    },
    {
      "id": "transaction-patch",
      "method": "PATCH", "path": "/transactions/{tx_id}",
      "request": { "category_id": "int|null (optional)", "confirmed": "bool (optional)", "is_refund": "bool (optional; validated against category types)", "splits": "[{category_id:int, amount_cents:int}] | [] to unsplit | absent to leave untouched (optional; 2+ parts, sum must equal amount_cents, parts share parent's sign)" },
      "response": "TransactionOut",
      "frontend_caller": "api.patchTransaction"
    },
    {
      "id": "transaction-delete",
      "method": "DELETE", "path": "/transactions/{tx_id}",
      "request": null,
      "response": { "deleted": "int" },
      "error_contract": "422 if source != manual (imported rows immutable)",
      "frontend_caller": "api.deleteTransaction"
    },
    {
      "id": "transaction-create-rule",
      "method": "POST", "path": "/transactions/{tx_id}/create-rule",
      "request": null,
      "response": { "rule_created": "string pattern", "transactions_updated": "int" },
      "error_contract": "400 if transaction has no category",
      "frontend_caller": "api.createRuleFromTransaction"
    },
    {
      "id": "standing-adjustments-list",
      "method": "GET", "path": "/standing-adjustments",
      "response": "StandingAdjustmentOut[] (amount_cents positive)",
      "frontend_caller": "api.getStandingAdjustments"
    },
    {
      "id": "standing-adjustment-create",
      "method": "POST", "path": "/standing-adjustments",
      "request": { "name": "string unique", "amount_cents": "int > 0", "income_category_id": "int (income type)", "expense_category_id": "int (needs/wants/savings)", "active": "bool=true", "start_month": "date optional, defaults current month 1st" },
      "response": "StandingAdjustmentOut (201)",
      "frontend_caller": "api.createStandingAdjustment"
    },
    {
      "id": "standing-adjustment-patch",
      "method": "PATCH", "path": "/standing-adjustments/{sa_id}",
      "request": "any subset of create fields",
      "response": "StandingAdjustmentOut",
      "frontend_caller": "api.patchStandingAdjustment"
    },
    {
      "id": "standing-adjustment-delete",
      "method": "DELETE", "path": "/standing-adjustments/{sa_id}",
      "response": { "deleted": "int" },
      "notes": "Materialised transactions survive with cleared link",
      "frontend_caller": "api.deleteStandingAdjustment"
    },
    {
      "id": "categories-list",
      "method": "GET", "path": "/categories",
      "response": "CategoryOut[] ordered by sort_order",
      "frontend_caller": "api.getCategories"
    },
    {
      "id": "category-create",
      "method": "POST", "path": "/categories",
      "request": { "name": "string unique non-blank", "type": "needs|wants|savings|income|exclude", "sort_order": "int optional (default max+1)" },
      "response": "CategoryOut (201); budgeted types also get a zero-amount default Budget row",
      "frontend_caller": "api.createCategory"
    },
    {
      "id": "category-patch",
      "method": "PATCH", "path": "/categories/{category_id}",
      "request": { "name": "string optional", "type": "string optional" },
      "response": "CategoryOut",
      "v2_change_category_type_guard": {
        "behaviour": "Changing type is REJECTED with 422 when dependents exist: transactions/splits referencing it whose sign no longer fits, rules on it, or standing adjustments pointing at it — unless request includes force:true",
        "force_field": "force: bool = false added to request body",
        "response_on_block": "422 {detail} listing dependent counts (same census shape delete uses)"
      },
      "frontend_caller": "api.patchCategory"
    },
    {
      "id": "category-reorder",
      "method": "PATCH", "path": "/categories/reorder",
      "request": { "category_ids": "int[] len>=2, complete permutation subset" },
      "response": "[{id, sort_order}] in request order",
      "frontend_caller": "api.reorderCategories"
    },
    {
      "id": "category-delete",
      "method": "DELETE", "path": "/categories/{category_id}",
      "response": { "deleted": "int" },
      "error_contract": "422 with per-kind usage counts when in use by transaction/split/rule/standing-adjustment",
      "frontend_caller": "api.deleteCategory"
    },
    {
      "id": "budget-get",
      "method": "GET", "path": "/budget",
      "query": { "month": "YYYY-MM required" },
      "response": "BudgetRow[]: { id, category_id, category_name, category_type, month, planned_amount_cents, actual_amount_cents } — actual nets refunds and reads split parts; auto-populates from defaults; may be negative",
      "frontend_caller": "api.getBudget"
    },
    {
      "id": "budget-patch-month",
      "method": "PATCH", "path": "/budget/{budget_id}",
      "request": { "planned_amount_cents": "int" },
      "response": "{ id, planned_amount_cents, category_name, month }",
      "frontend_caller": "api.patchBudget"
    },
    {
      "id": "budget-patch-default",
      "method": "PATCH", "path": "/budget/defaults/{category_id}",
      "request": { "planned_amount_cents": "int" },
      "response": "{ category_id, planned_amount_cents }",
      "frontend_caller": null,
      "$note": "No api.ts caller today; contract kept because endpoint exists"
    },
    {
      "id": "rules-list",
      "method": "GET", "path": "/rules",
      "response": "RuleOut[] ordered priority desc",
      "frontend_caller": "api.getRules"
    },
    {
      "id": "rule-create",
      "method": "POST", "path": "/rules",
      "request": { "pattern": "string substring, matched case-insensitively", "category_id": "int", "priority": "int=0" },
      "response": "RuleOut",
      "frontend_caller": "api.createRule"
    },
    {
      "id": "rule-update",
      "method": "PATCH", "path": "/rules/{rule_id}",
      "request": "subset of {pattern, category_id, priority}",
      "response": "RuleOut",
      "frontend_caller": null
    },
    {
      "id": "rule-delete",
      "method": "DELETE", "path": "/rules/{rule_id}",
      "response": { "deleted": "int" },
      "frontend_caller": "api.deleteRule"
    },
    {
      "id": "rule-test",
      "method": "POST", "path": "/rules/test",
      "request": { "pattern": "string" },
      "response": { "matches": "int (max 20 counted)", "examples": "string[] up to 5" },
      "frontend_caller": null
    },
    {
      "id": "dashboard-summary",
      "method": "GET", "path": "/dashboard/summary",
      "query": { "month": "YYYY-MM required; triggers standing-adjustment materialisation" },
      "response": {
        "month": "string",
        "total_income_cents": "int",
        "total_expenses_cents": "int",
        "total_savings_cents": "int",
        "left_over_cents": "int (= income - expenses)",
        "category_breakdown": "[{category_id, category_name, actual_cents, planned_cents, type}] needs/wants/savings only, refunds netted",
        "income_breakdown": "[{category_id, category_name, amount_cents}] income-type categories, refunds excluded",
        "needs_wants_savings": "{ needs_cents, wants_cents, savings_cents }",
        "monthly_trend": "[{month, total_cents}] last 6 financial months incl. requested"
      },
      "frontend_caller": "api.getDashboard"
    },
    {
      "id": "settings-get",
      "method": "GET", "path": "/settings",
      "response": "map<string,string> e.g. { financial_month_start_day: \"24\" }",
      "frontend_caller": "api.getSettings"
    },
    {
      "id": "setting-patch",
      "method": "PATCH", "path": "/settings/{key}",
      "request": { "value": "string (validated per key; financial_month_start_day must be 1-28 digits)" },
      "response": "{ key, value }",
      "error_contract": "404 unknown key, 422 invalid value",
      "frontend_caller": "api.patchSetting"
    }
  ],
  "shared_envelope_shapes": {
    "TransactionOut": {
      "id": "int", "date": "YYYY-MM-DD", "amount_cents": "int (negative = expense, positive = income or refund)",
      "description": "string", "source": "ing|revolut|degiro|manual",
      "category_id": "int|null (null when split)", "category_name": "string|null",
      "confirmed": "bool", "categorised_by": "rule|ai|manual|null",
      "ai_confidence": "float|null", "is_refund": "bool",
      "standing_adjustment_id": "int|null",
      "splits": "[{id, category_id, category_name, amount_cents, is_refund(bool, v2)}] empty when unsplit"
    },
    "StandingAdjustmentOut": { "id": "int", "name": "string", "amount_cents": "int>0", "income_category_id": "int", "expense_category_id": "int", "active": "bool", "start_month": "date" },
    "CategoryOut": { "id": "int", "name": "string", "type": "needs|wants|savings|income|exclude", "sort_order": "int" },
    "RuleOut": { "id": "int", "pattern": "string", "category_id": "int", "category_name": "string", "priority": "int" }
  }
}
